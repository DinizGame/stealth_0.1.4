[gd_scene format=3 uid="uid://bl6wyev1ft8sm"]

[sub_resource type="GDScript" id="GDScript_y2lae"]
resource_name = "AudioBase"
script/source = "extends PanelContainer

@onready var label: Label = $VBoxContainer/Label
@onready var h_slider: HSlider = $VBoxContainer/HSlider

@export var id: String
@export var titulo: String

func _ready() -> void:
	if not AutoConfig.resetar_audio.is_connected(_on_reset_audio):
		AutoConfig.resetar_audio.connect(_on_reset_audio)
	label.text = titulo
	# Carrega valor já salvo
	h_slider.value = AutoConfig.get_audio(id)

func _on_h_slider_value_changed(value: float) -> void:
	AutoConfig.set_audio(id, value)

func _on_reset_audio():
	h_slider.value = AutoConfig.get_audio(id)
	_on_h_slider_value_changed(h_slider.value)
"

[node name="AudioBase" type="PanelContainer" unique_id=926352885]
script = SubResource("GDScript_y2lae")

[node name="VBoxContainer" type="VBoxContainer" parent="." unique_id=1624883892]
layout_mode = 2

[node name="Label" type="Label" parent="VBoxContainer" unique_id=2033998967]
layout_mode = 2

[node name="HSlider" type="HSlider" parent="VBoxContainer" unique_id=1900410787]

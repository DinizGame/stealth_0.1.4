[gd_scene format=3 uid="uid://dgn0yob3qejfc"]

[sub_resource type="GDScript" id="GDScript_i0ni8"]
resource_name = "PanelExtra"
script/source = "extends AspectRatioContainer

var ID: String
var json_title: String
var json_descricao: String
var scene_path: String
var preview_path: String
var requirements: Dictionary = {}

const RETURN_SCENE_META := &\"extras_return_scene\"

@onready var title: Label = $VBoxContainer/PanelContainer/VBoxContainer/HBoxContainer/Title
@onready var help_txt: Label = $VBoxContainer/PanelContainer/VBoxContainer/HSeparator/HelpTXT
@onready var h_separator: HSeparator = $VBoxContainer/HSeparator
@onready var h_separator_2: HSeparator = $VBoxContainer/HSeparator2


func _ready() -> void:
	AutoConfig.atualizar_resolution.connect(_ajuste_largura)
	_ajuste_largura()
	
func _ajuste_largura():
	await get_tree().process_frame
	
	var largura_tela := get_viewport_rect().size.x
	var um_terco_x := largura_tela / 3.0
	custom_minimum_size.x = um_terco_x
	
	await get_tree().process_frame

func configurar(dados: Dictionary) -> void:
	ID = dados.get(\"id\", \"\")
	json_title = dados.get(\"title\", \"\")
	json_descricao = dados.get(\"help\", \"\")
	scene_path = dados.get(\"next_scene\", \"\")
	preview_path = dados.get(\"preview\", \"\")
	requirements = dados.get(\"requires\", {})

	title.text = json_title
	help_txt.text = json_descricao
	help_txt.hide()

func _on_painel_selecionado(index_selecionado: int, meu_index: int) -> void:
	var selecionado := index_selecionado == meu_index

	if selecionado:
		_receber_foco()
	else:
		_perder_foco()

func _receber_foco() -> void:
	modulate.a = 1.0
	h_separator.hide()
	h_separator_2.hide()
	z_index = 10

	_set_botoes_ativos(true)


func _perder_foco() -> void:
	modulate.a = 0.45
	h_separator.show()
	h_separator_2.show()
	z_index = 0
	
	_set_botoes_ativos(false)

func _set_botoes_ativos(ativo: bool) -> void:
	for child in get_children():
		_set_botoes_ativos_recursivo(child, ativo)

func _set_botoes_ativos_recursivo(node: Node, ativo: bool) -> void:
	if node is BaseButton:
		var button := node as BaseButton
		button.disabled = not ativo

	for child in node.get_children():
		_set_botoes_ativos_recursivo(child, ativo)

func _on_help_toggled(toggled_on: bool) -> void:
	help_txt.visible = toggled_on


func _on_play_pressed() -> void:
	if scene_path == \"\":
		push_error(\"Nenhuma cena definida para o mod: \" + ID)
		return

	if not ResourceLoader.exists(scene_path):
		push_error(\"Cena do mod não encontrada: \" + scene_path)
		return
	if not _validar_dependencias():
		return

	var current_scene := get_tree().current_scene
	if current_scene and not current_scene.scene_file_path.is_empty():
		get_tree().set_meta(RETURN_SCENE_META, current_scene.scene_file_path)

	var error := get_tree().change_scene_to_file(scene_path)
	if error != OK:
		push_error(\"Erro %d ao abrir o mod '%s'.\" % [error, ID])

func _validar_dependencias() -> bool:
	var input_actions: Array = requirements.get(\"input_actions\", [])
	for action in input_actions:
		var action_name := StringName(str(action))
		if not InputMap.has_action(action_name):
			push_error(\"O mod '%s' requer a ação de input '%s'.\" % [ID, action_name])
			return false

	var autoloads: Array = requirements.get(\"autoloads\", [])
	for autoload_name in autoloads:
		if get_node_or_null(\"/root/\" + str(autoload_name)) == null:
			push_error(\"O mod '%s' requer o Autoload '%s'.\" % [ID, autoload_name])
			return false

	return true
"


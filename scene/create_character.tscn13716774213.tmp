[sub_resource type="GDScript" id="GDScript_jhet3"]
resource_name = "CreateCharacter"
script/source = "extends Control

@export var scene_path:PackedScene
@onready var panel_edicao: PanelContainer = %PanelEdicao

func _ready() -> void:
	panel_edicao.hide()

func _on_return_pressed() -> void:
	get_tree().change_scene_to_packed(scene_path)


func _on_check_button_toggled(toggled_on: bool) -> void:
	panel_edicao.visible = toggled_on
"


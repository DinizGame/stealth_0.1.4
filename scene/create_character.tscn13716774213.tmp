[sub_resource type="GDScript" id="GDScript_tg4hv"]
resource_name = "ControleCamera"
script/source = "extends SubViewportContainer

@onready var camera_3d: Camera3D = $SubViewport/Camera3D
@onready var player: Node3D = $SubViewport/MarkPlayer

@export_group(\"UI References\")
@export var scroll_horizontal: HSlider
@export var scroll_vertical: VSlider

@export_group(\"Camera Settings\")
@export var pan_speed: float = 0.005
@export var zoom_step: float = 0.2
@export var min_pan_y: float = 0.0
@export var max_pan_y: float = 1.5

@export_group(\"Player Settings\")
@export var player_rotation_speed: float = 0.005
# Nova variável de velocidade. Medida em radianos por segundo (ajuste a gosto).
@export var max_ui_rotation_speed: float = 3.0 

var _ui_rotation_tween: Tween

func _ready() -> void:
	# Configura a barra horizontal para atuar como \"joystick / acelerador\"
	if is_instance_valid(scroll_horizontal):
		scroll_horizontal.min_value = 0.0
		scroll_horizontal.max_value = 100.0
		
		# Aumenta a precisão do slider para garantir um movimento liso no 3D
		scroll_horizontal.step = 0.01 
		scroll_horizontal.value = 50.0
		
		# Conectando os sinais de clicar e soltar a barra
		scroll_horizontal.drag_started.connect(_on_horizontal_drag_started)
		scroll_horizontal.drag_ended.connect(_on_horizontal_drag_ended)
		
	# Configura o slider vertical (0 a 100) e sincroniza com o Y inicial
	if is_instance_valid(scroll_vertical):
		scroll_vertical.min_value = 0.0
		scroll_vertical.max_value = 100.0
		scroll_vertical.step = 0.01
		
		var percent := inverse_lerp(min_pan_y, max_pan_y, camera_3d.global_position.y)
		scroll_vertical.set_value_no_signal(percent * 100.0)


# A rotação contínua baseada no acelerador DEVE acontecer no _process
func _process(delta: float) -> void:
	if is_instance_valid(scroll_horizontal) and scroll_horizontal.value != 50.0:
		if is_instance_valid(player):
			# Normaliza a barra de 0 a 100 para um eixo de -1.0 a 1.0 (onde 50 é o zero)
			var eixo_rotacao := (scroll_horizontal.value - 50.0) / 50.0
			
			# Multiplica o eixo pela velocidade máxima e o delta. 
			# O sinal negativo garante que direita é horário.
			player.rotate_y(eixo_rotacao * max_ui_rotation_speed * delta)


func _input(event: InputEvent) -> void:
	# --- 1. SISTEMA DE ZOOM ---
	if event is InputEventMouseButton:
		if event.pressed:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				camera_3d.size = clampf(camera_3d.size - zoom_step, 0.3, 3.0)
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				camera_3d.size = clampf(camera_3d.size + zoom_step, 0.3, 3.0)
			elif event.button_index == MOUSE_BUTTON_MIDDLE:
				Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		
		# Soltou a rodinha -> Devolve o mouse pro sistema
		elif not event.pressed and event.button_index == MOUSE_BUTTON_MIDDLE:
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

	# --- 2. SISTEMA DE PAN & ROTAÇÃO LIVRE COM O MOUSE ---
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		# Eixo Y do Mouse -> Move a Câmera
		var dynamic_sensitivity: float = pan_speed * camera_3d.size
		var pan_motion: Vector3 = camera_3d.transform.basis.y * event.relative.y
		
		var target_pos: Vector3 = camera_3d.global_position - (pan_motion * dynamic_sensitivity)
		target_pos.y = clampf(target_pos.y, min_pan_y, max_pan_y)
		camera_3d.global_position = target_pos
		
		# Sincroniza a barra vertical com o movimento do mouse
		if is_instance_valid(scroll_vertical):
			var percent := inverse_lerp(min_pan_y, max_pan_y, camera_3d.global_position.y)
			scroll_vertical.set_value_no_signal(percent * 100.0)
		
		# Eixo X do Mouse -> Rotaciona o Player
		if is_instance_valid(player):
			player.rotate_y(-event.relative.x * player_rotation_speed)


func _on_pan_vertical_value_changed(value: float) -> void:
	# O Pan vertical ainda usa value_changed, porque ele espelha posições físicas exatas
	var percent := value / 100.0
	var target_y: float = lerp(min_pan_y, max_pan_y, percent)
	camera_3d.global_position.y = clampf(target_y, min_pan_y, max_pan_y)


# -- NOVAS FUNÇÕES PARA O COMPORTAMENTO DE \"ACELERADOR/ELÁSTICO\" DA BARRA HORIZONTAL --

func _on_horizontal_drag_started() -> void:
	# Se o jogador agarrar a barra enquanto o elástico está puxando ela de volta, nós cancelamos o elástico
	if _ui_rotation_tween and _ui_rotation_tween.is_valid():
		_ui_rotation_tween.kill()

func _on_horizontal_drag_ended(_value_changed: bool) -> void:
	# Quando o jogador solta a barra, criamos o Tween para puxar de volta pro 50.0
	if is_instance_valid(scroll_horizontal):
		_ui_rotation_tween = create_tween()
		
		# Ajuste o 0.2 para definir quão rápido a mola puxa a barra de volta
		_ui_rotation_tween.tween_property(scroll_horizontal, \"value\", 50.0, 0.2).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
"


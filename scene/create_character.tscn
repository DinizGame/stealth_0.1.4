[sub_resource type="GDScript" id="GDScript_tg4hv"]
resource_name = "ControleCamera"
script/source = "extends SubViewportContainer


@onready var camera_3d: Camera3D = $SubViewport/Camera3D
@onready var player: Node3D = %MarkPlayer


@export_group(\"3D References\")
## Alvo para o qual a câmera permanecerá olhando.
## Arraste o nó MarkerPan para este campo no Inspector.
@export var pan_target: Marker3D


@export_group(\"UI References\")
@export var scroll_horizontal: HSlider
@export var scroll_vertical: VSlider


@export_group(\"Camera Settings\")
## Sensibilidade do pan vertical pelo mouse.
@export var pan_speed: float = 0.005

## Limites locais do MarkerPan no eixo Y.
@export var min_pan_y: float = 0.0
@export var max_pan_y: float = 1.5


@export_group(\"Zoom Settings\")
## Zoom realizado pela roda do mouse.
@export var zoom_step: float = 0.2

## Velocidade do zoom contínuo pelos botões.
@export var zoom_speed: float = 1.5

@export var min_zoom: float = 0.3
@export var max_zoom: float = 3.0


@export_group(\"Player Settings\")
## Sensibilidade da rotação horizontal pelo mouse.
@export var player_rotation_speed: float = 0.005

## Velocidade máxima da rotação controlada pelo slider horizontal.
## Medida em radianos por segundo.
@export var max_ui_rotation_speed: float = 3.0


var _zoom_direction: float = 0.0
var _ui_rotation_tween: Tween


func _ready() -> void:
	if not is_instance_valid(pan_target):
		push_error(
			\"ControleCamera: atribua o nó MarkerPan ao campo 'pan_target' no Inspector.\"
		)
	else:
		# Garante que o alvo comece dentro dos limites configurados.
		_set_pan_y(pan_target.position.y, false)
		_update_camera_look()

	_configurar_slider_horizontal()
	_configurar_slider_vertical()


func _process(delta: float) -> void:
	_processar_rotacao_continua(delta)
	_processar_zoom_continuo(delta)

	# Mantém a câmera olhando para o MarkerPan o tempo todo.
	_update_camera_look()


func _input(event: InputEvent) -> void:
	_processar_zoom_mouse(event)
	_processar_movimento_mouse(event)


# ---------------------------------------------------------------------------
# CONFIGURAÇÃO DA INTERFACE
# ---------------------------------------------------------------------------

func _configurar_slider_horizontal() -> void:
	if not is_instance_valid(scroll_horizontal):
		return

	scroll_horizontal.min_value = 0.0
	scroll_horizontal.max_value = 100.0
	scroll_horizontal.step = 0.01
	scroll_horizontal.value = 50.0

	if not scroll_horizontal.drag_started.is_connected(
		_on_horizontal_drag_started
	):
		scroll_horizontal.drag_started.connect(
			_on_horizontal_drag_started
		)

	if not scroll_horizontal.drag_ended.is_connected(
		_on_horizontal_drag_ended
	):
		scroll_horizontal.drag_ended.connect(
			_on_horizontal_drag_ended
		)


func _configurar_slider_vertical() -> void:
	if not is_instance_valid(scroll_vertical):
		return

	scroll_vertical.min_value = 0.0
	scroll_vertical.max_value = 100.0
	scroll_vertical.step = 0.01

	if not scroll_vertical.value_changed.is_connected(
		_on_pan_vertical_value_changed
	):
		scroll_vertical.value_changed.connect(
			_on_pan_vertical_value_changed
		)

	_sync_vertical_slider()


# ---------------------------------------------------------------------------
# CONTROLE DA CÂMERA
# ---------------------------------------------------------------------------

func _update_camera_look() -> void:
	if not is_instance_valid(camera_3d):
		return

	if not is_instance_valid(pan_target):
		return

	var camera_position: Vector3 = camera_3d.global_position
	var target_position: Vector3 = pan_target.global_position
	var direction: Vector3 = target_position - camera_position

	# look_at() não pode receber a própria posição da câmera como alvo.
	if direction.length_squared() <= 0.000001:
		return

	# Também evita o caso em que a direção fica totalmente paralela
	# ao vetor vertical, o que deixaria a rotação indefinida.
	var normalized_direction: Vector3 = direction.normalized()

	if absf(normalized_direction.dot(Vector3.UP)) >= 0.9999:
		return

	camera_3d.look_at(target_position, Vector3.UP)


func _set_pan_y(new_y: float, synchronize_slider: bool = true) -> void:
	if not is_instance_valid(pan_target):
		return

	var target_position: Vector3 = pan_target.position

	target_position.y = clampf(
		new_y,
		min_pan_y,
		max_pan_y
	)

	pan_target.position = target_position

	_update_camera_look()

	if synchronize_slider:
		_sync_vertical_slider()


func _sync_vertical_slider() -> void:
	if not is_instance_valid(scroll_vertical):
		return

	if not is_instance_valid(pan_target):
		return

	var pan_range: float = max_pan_y - min_pan_y
	var percent: float = 0.0

	if not is_zero_approx(pan_range):
		percent = inverse_lerp(
			min_pan_y,
			max_pan_y,
			pan_target.position.y
		)

	percent = clampf(percent, 0.0, 1.0)

	scroll_vertical.set_value_no_signal(percent * 100.0)


# ---------------------------------------------------------------------------
# PROCESSAMENTO CONTÍNUO
# ---------------------------------------------------------------------------

func _processar_rotacao_continua(delta: float) -> void:
	if not is_instance_valid(scroll_horizontal):
		return

	if not is_instance_valid(player):
		return

	if is_equal_approx(scroll_horizontal.value, 50.0):
		return

	var rotation_axis: float = (
		(scroll_horizontal.value - 50.0) / 50.0
	)

	player.rotate_y(
		rotation_axis
		* max_ui_rotation_speed
		* delta
	)


func _processar_zoom_continuo(delta: float) -> void:
	if is_zero_approx(_zoom_direction):
		return

	camera_3d.size = clampf(
		camera_3d.size
		+ _zoom_direction
		* zoom_speed
		* delta,
		min_zoom,
		max_zoom
	)


# ---------------------------------------------------------------------------
# CONTROLE PELO MOUSE
# ---------------------------------------------------------------------------

func _processar_zoom_mouse(event: InputEvent) -> void:
	if event is not InputEventMouseButton:
		return

	var mouse_event: InputEventMouseButton = event

	if mouse_event.button_index == MOUSE_BUTTON_WHEEL_UP:
		if mouse_event.pressed:
			camera_3d.size = clampf(
				camera_3d.size - zoom_step,
				min_zoom,
				max_zoom
			)

	elif mouse_event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
		if mouse_event.pressed:
			camera_3d.size = clampf(
				camera_3d.size + zoom_step,
				min_zoom,
				max_zoom
			)

	elif mouse_event.button_index == MOUSE_BUTTON_MIDDLE:
		if mouse_event.pressed:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		else:
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE


func _processar_movimento_mouse(event: InputEvent) -> void:
	if event is not InputEventMouseMotion:
		return

	if Input.get_mouse_mode() != Input.MOUSE_MODE_CAPTURED:
		return

	var mouse_motion: InputEventMouseMotion = event

	# Movimento vertical:
	# agora move o MarkerPan, não a câmera.
	if is_instance_valid(pan_target):
		var dynamic_sensitivity: float = (
			pan_speed * camera_3d.size
		)

		var new_pan_y: float = (
			pan_target.position.y
			- mouse_motion.relative.y
			* dynamic_sensitivity
		)

		_set_pan_y(new_pan_y)

	# Movimento horizontal:
	# continua rotacionando o MarkPlayer normalmente.
	if is_instance_valid(player):
		player.rotate_y(
			-mouse_motion.relative.x
			* player_rotation_speed
		)


# ---------------------------------------------------------------------------
# SLIDER VERTICAL
# ---------------------------------------------------------------------------

func _on_pan_vertical_value_changed(value: float) -> void:
	var percent: float = clampf(
		value / 100.0,
		0.0,
		1.0
	)

	var target_y: float = lerp(
		min_pan_y,
		max_pan_y,
		percent
	)

	_set_pan_y(target_y, false)


# ---------------------------------------------------------------------------
# SLIDER HORIZONTAL
# ---------------------------------------------------------------------------

func _on_horizontal_drag_started() -> void:
	if (
		_ui_rotation_tween != null
		and _ui_rotation_tween.is_valid()
	):
		_ui_rotation_tween.kill()


func _on_horizontal_drag_ended(
	_value_changed: bool
) -> void:
	if not is_instance_valid(scroll_horizontal):
		return

	_ui_rotation_tween = create_tween()

	_ui_rotation_tween.tween_property(
		scroll_horizontal,
		\"value\",
		50.0,
		0.2
	).set_trans(
		Tween.TRANS_CUBIC
	).set_ease(
		Tween.EASE_OUT
	)


# ---------------------------------------------------------------------------
# BOTÕES DE ZOOM
# ---------------------------------------------------------------------------

func _on_zoom_down_button_down() -> void:
	# Aumentar o size afasta o enquadramento.
	_zoom_direction = 1.0


func _on_zoom_down_button_up() -> void:
	if _zoom_direction > 0.0:
		_zoom_direction = 0.0


func _on_zoom_up_button_down() -> void:
	# Diminuir o size aproxima o enquadramento.
	_zoom_direction = -1.0


func _on_zoom_up_button_up() -> void:
	if _zoom_direction < 0.0:
		_zoom_direction = 0.0
"

